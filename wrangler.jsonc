{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shorturl",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "shorturl"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "0baf2340573e46598a43b783e0c103c3",
      "id": "c906784d2c0840c9aab050447253778e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "preview_bucket_name": "shorturl-backup",
      "bucket_name": "shorturl-backup"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  },
  "env": {
    "dev": {
      "name": "shorturl-dev",
      "kv_namespaces": [
        {
          "binding": "KV",
          "preview_id": "0baf2340573e46598a43b783e0c103c3",
          "id": "0baf2340573e46598a43b783e0c103c3"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "preview_bucket_name": "shorturl-backup",
          "bucket_name": "shorturl-backup"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "shorturl-dev"
        }
      ]
    }
  }
}
